# ---------------------------------------------------------------------------
# Generated protobuf stubs (produced at image build time)
# ---------------------------------------------------------------------------
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi

# Proto files copied into build contexts by build-and-push.sh.
# The canonical copies live in proto/ and are tracked.
backend/demo.proto
proxy-sdk/demo.proto
proxy-sdk/sdk_service.proto

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Secrets and credentials -- never commit
# ---------------------------------------------------------------------------
.env
.env.local
*.pem
*.key
*.crt
credentials
secrets/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store

# ---------------------------------------------------------------------------
# Logs and build output
# ---------------------------------------------------------------------------
*.log
build.log

# Generated by build-and-push.sh -- account/Region-specific, never committed
proxy-envoy/Dockerfile.rendered

# ---------------------------------------------------------------------------
# Security scanner working directories
# ---------------------------------------------------------------------------
# Scanner output reproduces upstream advisory text verbatim, which can include
# maintainers' personal email addresses. Keeping these out of the repository
# means running a scanner locally cannot commit third-party PII.
.semgrep/
.trivy/
